---
import Zaklad from '../layouts/Zaklad.astro';
import { strom, url, nazev, pocetPoznamek, jeVyplneno, datum, hezkeDatum } from '../lib/strom';
import { ikona } from '../lib/ikony';
import { nastaveni } from '../nastaveni';

const { podle, vse } = await strom();
const id = `semestry/${String(nastaveni.aktualniSemestr).padStart(2, '0')}-semestr`;
const semestr = podle.get(id);
const predmety = semestr?.deti.filter((d) => d.stranka) ?? [];

// Poslední poznámky podle data v hlavičce (datum: RRRR-MM-DD).
const posledni = vse
  .filter((p) => datum(p) && p.id.startsWith('semestry/'))
  .sort((a, b) => datum(b).localeCompare(datum(a)))
  .slice(0, 8)
  .map((p) => ({ p, predmet: podle.get(p.id.slice(0, p.id.lastIndexOf('/')))?.nazev ?? '' }));
---
<Zaklad aktivni="" siroke>
  <div class="domov" data-pagefind-ignore="all">
    <section class="uvod">
      <p class="nadtitulek">{nastaveni.podtitul}</p>
      <h1>{nastaveni.nazev}</h1>
      <button type="button" class="velke-hledani" data-hledat>
        <span set:html={ikona('hledat')} />
        <span>Hledat v poznámkách…</span>
        <kbd>/</kbd>
      </button>
    </section>

    <section class="blok">
      <div class="blok-hlava">
        <h2>{semestr?.nazev ?? `${nastaveni.aktualniSemestr}. semestr`}</h2>
      </div>
      <div class="karty predmety">
        {predmety.map((u, i) => (
          <a class="karta predmet" href={url(u.id)} style={`--odstin: ${(i * 47 + 150) % 360}`}>
            <span class="predmet-pruh" />
            {jeVyplneno(u.stranka!.data.zkratka) && <span class="predmet-meta"><span class="cip">{u.stranka!.data.zkratka}</span></span>}
            <strong>{u.nazev}</strong>
            <small>{pocetPoznamek(u) === 0 ? 'Zatím bez poznámek' : `${pocetPoznamek(u)} ${pocetPoznamek(u) === 1 ? 'poznámka' : pocetPoznamek(u) < 5 ? 'poznámky' : 'poznámek'}`}</small>
          </a>
        ))}
      </div>
    </section>

    {posledni.length > 0 && (
      <section class="blok">
        <h2>Poslední poznámky</h2>
        <ul class="seznam">
          {posledni.map(({ p, predmet }) => (
            <li><a href={url(p.id)}><span set:html={ikona('soubor', 18)} /><span><strong>{nazev(p)}</strong><small>{predmet} · {hezkeDatum(datum(p))}</small></span></a></li>
          ))}
        </ul>
      </section>
    )}

    <p class="pro-spoluzaky">
      <span set:html={ikona('lide', 18)} />
      <span>Poznámky jsou volně k použití. Našel jsi chybu? <a href={url('spoluzaci')}>Jak přispět</a></span>
    </p>
  </div>
</Zaklad>
